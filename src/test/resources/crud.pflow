fork("FORK0") {
  loop("LOOP1") { while (eval("true")) {
    if (isActive("update", "LOOP1")) return
  } } // LOOP1
} forkAgain("FORK0") {
  loop("LOOP2") { while (eval("true")) {
    if (isActive("deactivate", "LOOP2")) return
    if (isActive("activate", "LOOP2")) return
  } } // LOOP2
}; if (endFork("FORK0")) return
